{
  "dashboard": {
    "title": "Система управления доступом - Мониторинг",
    "tags": ["access-control", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Загрузка CPU (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU Usage"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Использование памяти (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "Memory Usage"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Использование диска (%)",
        "type": "gauge",
        "targets": [
          {
            "expr": "(node_filesystem_size_bytes{fstype!=\"rootfs\"} - node_filesystem_avail_bytes{fstype!=\"rootfs\"}) / node_filesystem_size_bytes{fstype!=\"rootfs\"} * 100",
            "legendFormat": "Disk Usage"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Активные соединения с БД",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"access_control_db\"}",
            "legendFormat": "Active Connections"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Размер базы данных (MB)",
        "type": "stat",
        "targets": [
          {
            "expr": "pg_database_size_bytes{datname=\"access_control_db\"} / 1024 / 1024",
            "legendFormat": "DB Size"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Транзакций в секунду",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit{datname=\"access_control_db\"}[5m])",
            "legendFormat": "Transactions/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}

